<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.1.4.6</Version>
    <IsExtensionProject>true</IsExtensionProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>JianProject.CysTerra</RootNamespace>
    <AssemblyName>JianProject.CysTerra</AssemblyName>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Description>用于接收及处理 Jian Project API 来源信息的核心组件。</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 接口包：ExcludeAssets=runtime 与 0.8.14 targets 等价；SDK10 restore 需写在 csproj -->
    <PackageReference Include="Cryville.EEW" Version="0.8.14" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.TagTypeKeys" Version="0.8.1" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.Analyzer" Version="0.8.7" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE.txt" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\COPYING.txt" Link="COPYING.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
