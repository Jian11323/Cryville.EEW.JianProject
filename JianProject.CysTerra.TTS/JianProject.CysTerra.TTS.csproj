<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.1.4.2</Version>
    <IsExtensionProject>true</IsExtensionProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>JianProject.CysTerra.TTS</RootNamespace>
    <AssemblyName>JianProject.CysTerra.TTS</AssemblyName>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Description>用于生成 Jian Project API 语音消息的组件。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cryville.EEW" Version="0.8.12" PrivateAssets="contentfiles;analyzers;build;runtime" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.TTS" Version="0.8.1" PrivateAssets="contentfiles;analyzers;build;runtime" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.Analyzer" Version="0.8.0" PrivateAssets="contentfiles;analyzers;build;runtime" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\JianProject.CysTerra\JianProject.CysTerra.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE.txt" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\COPYING.txt" Link="COPYING.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
