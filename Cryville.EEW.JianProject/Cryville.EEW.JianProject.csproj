<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.1.3.0</Version>
    <IsExtensionProject>true</IsExtensionProject>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Cryville.EEW.JianProject</RootNamespace>
    <AssemblyName>Cryville.EEW.JianProject</AssemblyName>
    <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
    <Description>用于接收及处理 Jian Project API 来源信息的核心组件。</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Cryville.EEW" Version="0.8.12" PrivateAssets="contentfiles;analyzers;build;runtime" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.TagTypeKeys" Version="0.8.1" PrivateAssets="contentfiles;analyzers;build;runtime" ExcludeAssets="runtime" />
    <PackageReference Include="Cryville.EEW.Analyzer" Version="0.8.0" PrivateAssets="contentfiles;analyzers;build;runtime" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\LICENSE.txt" Link="LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\COPYING.txt" Link="COPYING.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
